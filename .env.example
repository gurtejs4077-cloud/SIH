# ==============================================================================
# Real-Time Indian Airfare Price Intelligence Platform - Environment Variables
# ==============================================================================

# Data Provider Mode: "demo", "api", or "scraper"
# - demo: Uses synthetic statistical elasticity engine (is_demo = true)
# - api: Queries external verified aviation/OTA API (is_demo = false)
# - scraper: Uses ethical, rate-limited public scraper (is_demo = false)
DATA_PROVIDER=demo

# Database URL
# Defaults to local SQLite for instant zero-dependency testing.
# For production PostgreSQL: postgresql://airfare_user:secret@localhost:5432/airfare_db
DATABASE_URL=sqlite:///./airfare_intelligence.db

# Background Airfare Collection Scheduler Interval (minutes)
COLLECTION_INTERVAL_MINUTES=30

# External API Provider Credentials (required only when DATA_PROVIDER=api)
API_KEY=
API_SECRET=
API_BASE_URL=https://api.aviationprovider.com/v1

# Server Configuration
PORT=8000
HOST=0.0.0.0
